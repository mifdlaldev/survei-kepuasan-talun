{
  "name": "survei-kepuasan-talun",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:generate": "wrangler d1 migrations apply survei-kepuasan-talun-db --local",
    "db:deploy": "wrangler d1 migrations apply survei-kepuasan-talun-db --remote",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.33.0",
    "hono": "^4.13.11",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260801.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
